# FastAPI Server Settings
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Railway PostgreSQL Settings
# Railway will automatically provide DATABASE_URL in production
# For local development, you can also use Supabase:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_DB_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# AI and Voice Services
# Google Gemini LLM (for intent classification and petroleum engineering reasoning)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Sarvam AI Voice (for Saaras STT speech-to-text and Bulbul TTS text-to-speech)
# Obtain from: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_MODEL_STT=saaras:v1
SARVAM_MODEL_TTS=bulbul:v1

# Fallback local database for development (not used in Railway production)
DATABASE_URL=sqlite+aiosqlite:///./well_twin.db

# Manual SOS / Incident notification provider.
# "mock" (default): no real SMS/voice call is ever placed - safe for local dev and tests.
# "twilio": reserved for a later phase; not implemented yet.
NOTIFICATION_MODE=mock
